!Braces
String = '".*?("|$)'
Say = "say"
Set = "set"
And = "and"
If = "if"
Else = "else"
Int = '[+-]?[0-9]+'
Name = '[a-zA-Z_]+'
?Value = Name Int String
SetStatement = Set Name ?Value
IfStatement = If Name (Braces | ?Statement)
ElseStatement = Else (Braces | ?Statement)
SayStatement = Say ?Value +
AndStatement = And Name ?Value
?Statement = SetStatement IfStatement ElseStatement SayStatement AndStatement

= Braces ! String
  Begin = "{"
  End = "}"
  +
