
! Parenthesis
# String = '".*?[^\\]"'
# Eq = "="
# Int = '[+-]?[0-9][0-9_]*'
# Float = '[+-]?(([0-9][0-9_]*)?[.][0-9][0-9_]*|[0-9][0-9_]*[.])'
Name = '[a-z_]+'
# ?Value = String Int Float

FuncDecl = Name Name Parenthesis{FuncDeclArgs}

= Parenthesis # ! String
  Begin = "("
  End = ")"
  ! Parenthesis

= FuncDeclArgs
  # + String Name Eq Int Float
  Sep = ","
  Arg = Name Name
  # ArgDefault = Arg Eq ?Value

